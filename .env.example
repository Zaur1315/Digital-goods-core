DATABASE_DSN=sqlite:/tmp/digital-goods.sqlite

# Общий режим: normal | fail | timeout | duplicate | wrong
SUPPLIER_MODE=normal

# Настройки конкретного поставщика имеют приоритет над SUPPLIER_MODE.
# Для частичного сбоя оставьте A рабочим, а B переведите в fail.
SUPPLIER_A_MODE=normal
SUPPLIER_B_MODE=normal

# Лимит запросов в минуту: общий или отдельный для каждого поставщика.
SUPPLIER_RPM=60
SUPPLIER_A_RPM=60
SUPPLIER_B_RPM=60
